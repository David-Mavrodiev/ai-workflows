# Copy this file to ".env" and fill in real values. ".env" is gitignored.
# install.ps1 loads these into the process environment and uses them to resolve
# ${input:ID} / ${env:NAME} references when writing the Copilot CLI MCP config.

# GitHub Personal Access Token used by the "github" MCP server.
GITHUB_TOKEN=

# Optional. Base directory where the spec-workflow MCP server stores per-spec
# folders (<base>/<guid>/). Defaults to ~/specs if unset. The server reads this
# from its process environment, so set it where the MCP server runs (e.g. your
# shell profile) rather than only here.
# SPECS_DIR=
