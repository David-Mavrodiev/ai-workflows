{
  "name": "spec-workflow-mcp-server",
  "version": "1.0.0",
  "description": "Local MCP server for spec-driven development: interview-driven spec generation, file-backed storage, and task-state tracking (stdio).",
  "type": "module",
  "bin": {
    "spec-workflow-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "test": "node smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
